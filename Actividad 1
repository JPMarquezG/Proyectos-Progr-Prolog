%Regla 1

es_hijo_de(X, Y) :- es_padre_de(Y, Z), member(X, Z);
                    es_madre_de(Y, Z), member(X, Z) .

%Regla 2

es_nieto_de(X, Y) :- es_hijo_de(X, H), es_hijo_de(H, Y).

%Regla 3

es_primo_de(X, Y) :- (  es_madre_de(marge, H), member(X, H),es_madre_de(selma, [Y]) );
                     (  es_madre_de(marge, H), member(Y, H),es_madre_de(selma, [X]) ).
